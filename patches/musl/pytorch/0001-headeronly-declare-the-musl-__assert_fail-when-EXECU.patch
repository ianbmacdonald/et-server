From 72550c926ac63a0e00c0491e14fe8884d4e65f9b Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 00:51:50 -0400
Subject: [PATCH 1/2] headeronly: declare the musl __assert_fail when
 EXECUTORCH_LIBC_MUSL is set

ExecuTorch's optimized CPU kernels include this header from the torch
wheel next to ExecuTorch's vendored copy; both must declare musl's
__assert_fail(const char*, const char*, int, const char*), the
Emscripten form, or GCC rejects the conflict with the glibc form.
musl defines no identifying macro; the build passes
-DEXECUTORCH_LIBC_MUSL.

Assisted-by: claude:opus-5.5
---
 torch/headeronly/macros/Macros.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/torch/headeronly/macros/Macros.h b/torch/headeronly/macros/Macros.h
index cef99df..61a9ccd 100644
--- a/torch/headeronly/macros/Macros.h
+++ b/torch/headeronly/macros/Macros.h
@@ -494,7 +494,7 @@ extern SYCL_EXTERNAL void __assert_fail(
     const char* file,
     unsigned int line,
     const char* func);
-#elif (defined(__EMSCRIPTEN__))
+#elif (defined(__EMSCRIPTEN__) || defined(EXECUTORCH_LIBC_MUSL))
 // As defined in assert.h in the Emscripten stdlib
 _Noreturn void __assert_fail(
     const char* expr,
